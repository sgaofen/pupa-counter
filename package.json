{
  "name": "pupa-counter",
  "version": "0.5.0",
  "description": "Long Lab Drosophila pupa counter \u2014 Electron desktop app with bundled Python inference daemon (LiDE 300 v4 CNN). Scans (Windows WIA / macOS ImageCaptureCore), counts, lets you correct, and saves per replicate.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "package:mac": "npm run build && npm run build:icscan && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "lint": "eslint src --ext .ts,.tsx",
    "build:icscan": "mkdir -p electron/scanner/mac/bin && xcrun swiftc -O electron/scanner/mac/icscan.swift -o electron/scanner/mac/bin/icscan"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.longlab.pupacounter",
    "productName": "Pupa Counter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "electron/scanner/**"
    ],
    "extraResources": [
      {
        "from": "daemon/python-runtime",
        "to": "python-pipeline/python-runtime"
      },
      {
        "from": "daemon/pupa_counter.py",
        "to": "python-pipeline/pupa_counter.py"
      },
      {
        "from": "daemon/pupa_counter_daemon.py",
        "to": "python-pipeline/pupa_counter_daemon.py"
      },
      {
        "from": "daemon/sheet_detect.py",
        "to": "python-pipeline/sheet_detect.py"
      },
      {
        "from": "daemon/stage2.py",
        "to": "python-pipeline/stage2.py"
      },
      {
        "from": "daemon/model",
        "to": "python-pipeline/model",
        "filter": [
          "manifest.json",
          "pupa_counter_lide300_v5.pt",
          "stage2_clf_v5.pkl",
          "pupa_counter_lide300.pt",
          "peak_filter_clf_lide300.pkl"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "electron/scanner/mac/bin/icscan",
          "to": "icscan"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
